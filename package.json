{
  "name": "infominer-ca-portal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch server/index.ts\" \"vite --port 5173\"",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "seed": "tsx server/seed.ts",
    "lint": "tsc --noEmit -p tsconfig.json",
    "agent:build": "esbuild agent/src/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=agent/dist/infominer-agent.mjs --banner:js=\"// Infominer Tally sync agent. Built from agent/src.\"",
    "mock-tally": "tsx tools/mock-tally.ts",
    "demo:setup": "tsx tools/demo-agent-setup.ts",
    "demo:tally": "npm run agent:build && concurrently -k -n tally,agent \"tsx tools/mock-tally.ts\" \"node agent/dist/infominer-agent.mjs data/demo-agent/agent.json\"",
    "test:ui": "playwright test",
    "emulator": "JAVA_HOME=/opt/homebrew/opt/openjdk@21 firebase emulators:start --only firestore --project demo-infominer",
    "test:fs": "tsx tests/firestore-identity.mts",
    "test:fs:docs": "tsx tests/firestore-documents.mts",
    "test:fs:flow": "tsx tests/firestore-workflow.mts",
    "test:fs:privacy": "tsx tests/firestore-privacy.mts",
    "test:fs:http": "tsx tests/fs-http-auth.mts",
    "dev:fs": "concurrently -k -n api,web \"GRPC_DNS_RESOLVER=native tsx watch server/index-fs.ts\" \"vite --port 5173\"",
    "start:fs": "GRPC_DNS_RESOLVER=native NODE_ENV=production tsx server/index-fs.ts",
    "seed:fs": "GRPC_DNS_RESOLVER=native tsx server/seed-fs.ts"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1147.0",
    "@aws-sdk/client-sns": "^3.1147.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@google-cloud/firestore": "^9.3.1",
    "@google-cloud/storage": "^8.2.0",
    "@gsap/react": "^2.1.2",
    "cookie-parser": "^1.4.7",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "fast-xml-parser": "^5.11.2",
    "file-type": "^22.1.1",
    "gsap": "^3.15.0",
    "helmet": "^8.3.0",
    "lucide-react": "^1.52.0",
    "multer": "^2.4.0",
    "pdfkit": "^0.20.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.4",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
