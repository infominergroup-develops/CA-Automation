# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
API_PORT=3001
# Public origin of the web app (used for CSRF origin checks).
APP_ORIGIN=http://localhost:5173

# 32-byte keys, base64. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# MASTER_KEY encrypts every stored document. Losing it = losing all documents. Keep an offline backup.
MASTER_KEY=
# OTP_SECRET keys the HMAC used to store one-time codes.
OTP_SECRET=

# Where the database and encrypted files live. Use an encrypted disk in production.
DATA_DIR=./data

# OTP delivery: "console" (development only), "sms" (wire up a DLT-registered provider in server/security/otp.ts),
# or "off" (temporary: staff sign in with password only; client sign-in is refused).
OTP_PROVIDER=console

# Firebase / Firestore — used by the Admin SDK (@google-cloud/firestore).
# Set to your Firebase project ID.
GOOGLE_CLOUD_PROJECT=
# For local dev, point to the Firestore emulator (npm run emulator). Remove in production.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8089

# First Director account, created by `npm run seed`.
SEED_DIRECTOR_NAME=
SEED_DIRECTOR_EMAIL=
SEED_DIRECTOR_MOBILE=

# Hosting outside Google Cloud (e.g. DigitalOcean): the portal-run service-account key, base64-encoded.
# Not needed locally (gcloud auth application-default login) or on Cloud Run.
# GOOGLE_CREDENTIALS_BASE64=
